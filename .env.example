# Обязательные
TG_BOT_TOKEN=
TG_CHAT_ID=

# Telegram API (my.telegram.org): read dialogs and send messages on behalf of user
TG_API_ID=
TG_API_HASH=

# Secondary Telegram account (optional; login via ./telegram_work_login.sh)
# Вход: ./telegram_work_login.sh
TG_WORK_API_ID=
TG_WORK_HASH=

# Gmail: адрес и пароль приложения (myaccount.google.com/apppasswords), не основной пароль
GMAIL_ADDRESS=
GMAIL_PASSWORD=
# Дополнительные ящики Gmail: свой пароль приложения у каждого (_2 … _9).
# GMAIL_LABEL[_N]: display label for mailbox (defaults to local part before @)
# GMAIL_ADDRESS_2=
# GMAIL_PASSWORD_2=
# GMAIL_LABEL_2=

# University portal (read-only). Optional: omit credentials and log in manually with ./lk_login.sh
LK_LOGIN=
LK_PASSWORD=

# Secondary LLM (OpenAI API): background ingestion and chat fallback when Claude is unavailable.
OPENAI_API_KEY=
# Model overrides (defaults to first available tier model)
# OPENAI_MODEL=
# OPENAI_CHAT_MODEL=
# OPENAI_BUDGET_USD=9
# OPENAI_WARN_USD=7

# Claude API (token-billed): Haiku 5.5 for heartbeats, Sonnet 5.5 chat fallback under budget cap
CLAUDE_AI_API_KEY=
# CLAUDE_API_BUDGET_USD=10
# CLAUDE_API_WARN_USD=8

# Пароль шифрования ночных бэкапов. Храни его ещё где-то вне ноутбука!
BACKUP_PASSWORD=

# Необязательные (значения по умолчанию)
# UBERMENSCH_DATA=~/Projects/Ubermensch   # default runtime data directory
# UBERMENSCH_ROOTS=/mnt/data              # colon-separated extra scan directories
# OBSIDIAN_VAULT=                         # Obsidian vault path (read all, reports in 08 AI/Reports)
# ANYA_DOCUMENTS=                         # assistant workspace documents directory
# AI_CHATS_BACKUPS=~/Backups              # archived Claude Code transcripts
# CLAUDE_MODEL=opus            # primary model alias (opus or sonnet)
# CLAUDE_TIMEOUT=300
# CLAUDE_BIN=                  # путь к claude, если не найден автоматически

# Optional phone numbers for Telegram session bootstrap
# TG_PHONE=+7...
# TG_WORK_PHONE=+7...

# Права инструментов. Пути разделяются «:»; пустой список запрещает доступ без подтверждения.
# Ограничения чтения относятся к общим инструментам; в интерактивном Claude Code есть native Read.
# UBERMENSCH_READ_ROOTS=                 # colon-separated allowed read roots
# UBERMENSCH_WRITE_ROOTS=                # colon-separated interactive write roots
# UBERMENSCH_BACKGROUND_WRITE_ROOTS=     # colon-separated background write roots
# UBERMENSCH_SHELL_MODE=confirm          # confirm (sandbox or user approval) | disabled
# sandbox требует bubblewrap (bwrap), не имеет сети и видит только /usr и workspace/shell.
