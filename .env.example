# Обязательные
TG_BOT_TOKEN=
TG_CHAT_ID=

# Telegram API (my.telegram.org) — чтение переписок и отправка от имени владельца
TG_API_ID=
TG_API_HASH=

# Рабочий Telegram (второй аккаунт, своё приложение на my.telegram.org) — необязательно.
# Вход: telegram_work_login.bat
TG_WORK_API_ID=
TG_WORK_HASH=

# Gmail: адрес и пароль приложения (myaccount.google.com/apppasswords), не основной пароль
GMAIL_ADDRESS=
GMAIL_PASSWORD=

# Личный кабинет вуза (e.mospolytech.ru/old) — только чтение. Можно не задавать и войти
# вручную через lk_login.bat (тогда сессия истечёт — Освальд попросит войти снова).
LK_LOGIN=
LK_PASSWORD=

# Пароль шифрования ночных бэкапов. Храни его ещё где-то вне ноутбука!
BACKUP_PASSWORD=

# Необязательные (значения по умолчанию)
# UBERMENSCH_DATA=D:\Ubermensch
# CLAUDE_MODEL=opus            # opus — умнее, sonnet — быстрее и экономнее к лимитам подписки
# CLAUDE_TIMEOUT=300
# CLAUDE_BIN=                  # путь к claude.exe, если не найден автоматически
